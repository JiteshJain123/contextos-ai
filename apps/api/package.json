{
  "name": "@contextos-ai/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express + TypeScript backend API",
  "scripts": {
    "build": "tsup",
    "dev": "node --env-file=../../.env.local --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@contextos-ai/eslint-config": "workspace:*",
    "@contextos-ai/tsconfig": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@contextos-ai/config": "workspace:*",
    "@contextos-ai/database": "workspace:*",
    "@contextos-ai/validators": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "@node-rs/argon2": "^2.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jose": "^6.2.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  }
}