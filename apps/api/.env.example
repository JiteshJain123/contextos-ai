# ─────────────────────────────────────────────────────────────────────────────
# contextos-ai API — environment variable template
#
# Copy to .env.local for local dev. In production, set these directly in your
# deployment platform (Railway / Render / Fly.io / Docker Compose).
#
# [REQUIRED] = must be set or the API will refuse to start.
# [OPTIONAL] = has a default or is conditionally needed.
# NEVER commit real secrets. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production                         # development | test | production
LOG_LEVEL=info                              # trace | debug | info | warn | error | fatal

# ── HTTP Server ───────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL. Use ?sslmode=require on managed providers.
# Railway:   ${{ Postgres.DATABASE_URL }}
# Neon:      postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
# Supabase:  postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
# [REQUIRED] Minimum 32 chars. Use a CSPRNG-generated value, never a human password.
JWT_SECRET=

# [OPTIONAL] Token lifetimes (format: 15m | 1h | 7d | 30d)
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# [OPTIONAL] Cookie domain. Required only if the API and frontend are on
# different subdomains (e.g. api.example.com + app.example.com → .example.com).
# Leave unset for same-domain or CORS-separated deployments.
# COOKIE_DOMAIN=.example.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# [REQUIRED in production] Comma-separated allowed origins.
# Must exactly match the frontend URL: protocol + host, no trailing slash.
# Multiple: CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=https://app.example.com

# ── AI Providers ─────────────────────────────────────────────────────────────
# At least one is required for AI features to work.
# Without a key the server starts fine — /conversations/:id/messages returns 503.
# Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Optional Integrations ────────────────────────────────────────────────────
# Redis (required for multi-replica rate limiting + future session cache)
# REDIS_URL=redis://user:password@host:6379

# Pinecone (future: vector search for AI memory)
# PINECONE_API_KEY=
# PINECONE_INDEX=
# PINECONE_ENVIRONMENT=

# NOTE: RESEND_API_KEY / RESEND_FROM are NOT required.
# Email sending was removed from this build (single-user SaaS, no invite emails).
