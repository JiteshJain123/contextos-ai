# ─────────────────────────────────────────────────────────────────────────────
# contextos-ai Web — environment variable template
#
# Copy to .env.local for local dev. In production, set in your deployment
# platform (Vercel / Railway / Render / Docker Compose).
#
# SECURITY RULE: NEXT_PUBLIC_* vars are inlined into the browser bundle.
#   → Safe:   public URLs, app names, feature flags
#   → Never:  secrets, API keys, database URLs with credentials
#
# [REQUIRED] = must be set or the build / runtime will fail.
# [OPTIONAL] = has a default or is only needed for specific features.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (inlined into browser bundle at build time) ───────────────────────

# [REQUIRED] Human-readable application name shown in the UI.
NEXT_PUBLIC_APP_NAME=contextos-ai

# [REQUIRED] Canonical public URL of this frontend (used for OG metadata).
# Vercel: set to the production deployment URL.
NEXT_PUBLIC_APP_URL=https://app.example.com

# [REQUIRED] URL of the Express API. Must be reachable from the browser.
# No trailing slash. Used for all client-side API calls.
NEXT_PUBLIC_API_URL=https://api.example.com

# ── Server-only (used in Server Components / route handlers only) ─────────────

# [REQUIRED for server-side DB queries] PostgreSQL connection string.
# The web app uses this for direct Prisma access (e.g. future server actions).
# If the web app only talks to the API via HTTP, this can be omitted.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Build-time output (non-secret) ────────────────────────────────────────────

# Set to "standalone" for Docker / Railway / Render deployments to produce
# .next/standalone — a minimal self-contained bundle.
# DO NOT set for Vercel — Vercel handles output automatically.
# NEXT_OUTPUT=standalone
