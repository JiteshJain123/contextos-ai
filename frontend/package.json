  "private": true,
  "description": "Next.js frontend application",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "next build",
    "predev": "kill-port 3000 || true",
