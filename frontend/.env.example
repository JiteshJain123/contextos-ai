# ─────────────────────────────────────────────────────────────────────────────
# ContextOS AI — frontend (Next.js) environment template
#
# Copy to frontend/.env.local for local dev:
#   cp frontend/.env.example frontend/.env.local
# In production, set in your deployment platform (Vercel / Railway / Render).
#
# SECURITY RULE: NEXT_PUBLIC_* vars are inlined into the browser bundle.
#   → Safe:   public URLs, app names, publishable keys
#   → Never:  secrets, database URLs with credentials
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (inlined into browser bundle at build time) ───────────────────────

# [REQUIRED] Human-readable application name shown in the UI.
NEXT_PUBLIC_APP_NAME=contextos-ai

# [REQUIRED] Canonical public URL of this frontend (used for OG metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [REQUIRED] URL of the Express API. Must be reachable from the browser.
# No trailing slash. Used for all client-side API calls.
NEXT_PUBLIC_API_URL=http://localhost:4000

# [REQUIRED] Clerk publishable key (pk_test_... / pk_live_...) — safe to expose.
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Server-only (Clerk middleware / server components) ───────────────────────

# [REQUIRED] Clerk secret key (sk_test_... / sk_live_...) — never expose.
CLERK_SECRET_KEY=

# ── Build-time output (non-secret) ───────────────────────────────────────────

# Set to "standalone" for Docker / Railway / Render deployments to produce
# .next/standalone — a minimal self-contained bundle.
# DO NOT set for Vercel — Vercel handles output automatically.
# NEXT_OUTPUT=standalone
