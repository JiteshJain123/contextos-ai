generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(cuid())
  clerkId           String            @unique
  email             String            @unique
  name              String?
  role              UserRole          @default(USER)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  aiConversations   AiConversation[]
  uploadedDocuments ProjectDocument[] @relation("DocumentUploadedBy")
  projects          Project[]
  createdTasks      Task[]            @relation("TaskCreatedBy")

  @@index([clerkId])
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Project {
  id              String            @id @default(cuid())
  name            String
  slug            String
  description     String?
  ownerId         String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  aiContextCache  AiContextCache?
  aiConversations AiConversation[]
  insights        AiInsight[]
  automationRuns  AutomationRun[]
  documents       ProjectDocument[]
  health          ProjectHealth?
  memory          ProjectMemory?
  milestones      ProjectMilestone[]
  plan            ProjectPlan?
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks           Task[]

  @@unique([ownerId, slug])
  @@index([ownerId])
  @@index([deletedAt])
  @@map("projects")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  startDate   DateTime?
  dueDate     DateTime?
  position    Float        @default(0)
  projectId   String
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdBy   User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, position])
  @@index([createdById])
  @@index([deletedAt])
  @@map("tasks")
}

model AiConversation {
  id        String      @id @default(cuid())
  title     String      @default("New conversation")
  projectId String
  userId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([projectId, userId])
  @@index([userId])
  @@index([deletedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id               String         @id @default(cuid())
  role             AiMessageRole
  content          String
  conversationId   String
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime       @default(now())
  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model ProjectPlan {
  id        String   @id @default(cuid())
  projectId String   @unique
  goal      String
  markdown  String
  tasksJson Json
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_plans")
}

model AiInsight {
  id            String          @id @default(cuid())
  projectId     String
  type          InsightType
  content       String
  metadata      Json?
  severity      InsightSeverity @default(INFO)
  confidence    Float           @default(0.5)
  autoGenerated Boolean         @default(false)
  dismissedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([projectId])
  @@index([projectId, severity])
  @@map("ai_insights")
}

model ProjectHealth {
  id        String   @id @default(cuid())
  projectId String   @unique
  score     Float
  breakdown Json
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_health")
}

model AutomationRun {
  id            String          @id @default(cuid())
  projectId     String
  insightType   InsightType
  triggerReason String
  severity      InsightSeverity
  triggeredAt   DateTime        @default(now())
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([triggeredAt])
  @@map("automation_runs")
}

model ProjectDocument {
  id                  String          @id @default(cuid())
  projectId           String
  uploadedById        String
  filename            String
  originalName        String
  mimeType            String
  size                Int
  status              DocumentStatus  @default(PENDING)
  extractedText       String?
  summary             String?
  requirementsJson    Json?
  deadlinesJson       Json?
  risksJson           Json?
  suggestedTasksJson  Json?
  embeddingsCacheJson Json?
  processedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?
  chunks              DocumentChunk[]
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy          User            @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([uploadedById])
  @@index([status])
  @@index([deletedAt])
  @@map("project_documents")
}

model DocumentChunk {
  id         String          @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  embedding  Json?
  createdAt  DateTime        @default(now())
  document   ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chunkIndex])
  @@map("document_chunks")
}

model AiContextCache {
  id        String   @id @default(cuid())
  projectId String   @unique
  data      Json
  builtAt   DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("ai_context_caches")
}

model ProjectMemory {
  id                String        @id @default(cuid())
  projectId         String        @unique
  snapshotVersion   Int           @default(1)
  tasksJson         Json
  documentsJson     Json
  insightsJson      Json
  conversationsJson Json
  planJson          Json?
  teamJson          Json
  metricsJson       Json
  totalChunks       Int           @default(0)
  builtAt           DateTime      @default(now())
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks            MemoryChunk[]

  @@index([projectId])
  @@map("project_memories")
}

model MemoryChunk {
  id         String        @id @default(cuid())
  memoryId   String
  sourceType MemorySource
  sourceId   String
  content    String
  embedding  Json?
  metadata   Json?
  chunkIndex Int
  createdAt  DateTime      @default(now())
  memory     ProjectMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId, sourceType])
  @@index([sourceId])
  @@map("memory_chunks")
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  targetDate  DateTime
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([targetDate])
  @@map("project_milestones")
}

enum UserRole {
  USER
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum InsightType {
  NEXT_TASK
  OVERDUE_TASKS
  DAILY_SUMMARY
  WORKLOAD_PRIORITY
  BLOCKER_DETECTION
  SPRINT_IMPROVEMENTS
  WEEKLY_SUMMARY
  OVERDUE_RECOVERY
  INACTIVE_PROJECT
  BLOCKED_WORKFLOW
  PRODUCTIVITY_SLOWDOWN
  SPRINT_RISK
  OVERLOAD_WARNING
  STALE_CONTENT
  DEPENDENCY_ANALYSIS
  BLOCKER_CHAIN
  SPRINT_FORECAST
  DELAY_IMPACT
  WORKLOAD_IMBALANCE
  STALL_ANALYSIS
  CRITICAL_PATH
}

enum InsightSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MemorySource {
  TASK
  DOCUMENT
  INSIGHT
  CONVERSATION
  PLAN
  PROJECT
}
