{
  "name": "contextos-ai-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express + TypeScript backend API",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "predev": "kill-port 4000 || true",
    "dev": "node --env-file=.env.local --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "dotenv -e .env.local -- prisma migrate reset",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write . --cache --ignore-unknown",
    "format:check": "prettier --check . --cache --ignore-unknown",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.8.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "kill-port": "^2.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "prisma": "5.22.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "@clerk/express": "^2.1.26",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "5.22.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "svix": "^1.95.2",
    "zod": "^4.4.3"
  }
}
