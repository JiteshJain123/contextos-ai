# ─────────────────────────────────────────────────────────────────────────────
# ContextOS AI — backend (Express API) environment template
#
# Copy to backend/.env.local for local dev:
#   cp backend/.env.example backend/.env.local
# In production, set these directly in your deployment platform
# (Railway / Render / Fly.io / Docker Compose).
#
# [REQUIRED] = must be set or the API will refuse to start.
# [OPTIONAL] = has a default or is conditionally needed.
# NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development                        # development | test | production
LOG_LEVEL=info                              # trace | debug | info | warn | error | fatal

# ── HTTP Server ──────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0

# ── Database ─────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL. Use ?sslmode=require on managed providers.
# Also read by the Prisma CLI via packages/database db:* scripts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contextos_ai

# ── Auth — Clerk (https://dashboard.clerk.com → API Keys) ────────────────────
# [REQUIRED] Publishable key (pk_test_... / pk_live_...) — clerkMiddleware()
# needs it to verify session tokens.
CLERK_PUBLISHABLE_KEY=
# [REQUIRED] Backend secret key (sk_test_... / sk_live_...)
CLERK_SECRET_KEY=
# [REQUIRED] Webhook signing secret (whsec_...) — create a webhook endpoint in
# Clerk dashboard → Webhooks pointing at POST /api/webhooks/clerk.
CLERK_WEBHOOK_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# [REQUIRED in production] Comma-separated allowed origins.
# Must exactly match the frontend URL: protocol + host, no trailing slash.
CORS_ORIGIN=http://localhost:3000

# ── AI Providers ─────────────────────────────────────────────────────────────
# At least one is required for AI features to work.
# Without a key the server starts fine — AI routes return 503.
# Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Optional Integrations ────────────────────────────────────────────────────
# Redis (required for multi-replica rate limiting + future session cache)
# REDIS_URL=redis://user:password@host:6379

# Pinecone (future: vector search for AI memory)
# PINECONE_API_KEY=
# PINECONE_INDEX=
# PINECONE_ENVIRONMENT=
