# =============================================================
# contextos-ai — root environment template
#
# Copy this file to `.env` (gitignored) at the repo root for
# vars that are shared across apps. Per-app overrides live in
# apps/<app>/.env.local. NEVER commit real secrets.
# =============================================================

# --- Database (shared by api + web server actions) ---
DATABASE_URL="postgresql://contextos:contextos@localhost:5432/contextos_dev?schema=public"

# --- Runtime ---
NODE_ENV="development"
