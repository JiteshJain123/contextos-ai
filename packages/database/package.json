{
  "name": "@contextos-ai/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, generated client, and shared database access",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "files": [
    "src",
    "prisma"
  ],
  "scripts": {
    "build": "echo build placeholder",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "echo clean placeholder",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate dev",
    "db:push": "dotenv -e ../../.env.local -e ../../.env -- prisma db push",
    "db:studio": "dotenv -e ../../.env.local -e ../../.env -- prisma studio",
    "db:deploy": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate reset",
    "db:seed": "dotenv -e ../../.env.local -e ../../.env -- tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@contextos-ai/eslint-config": "workspace:*",
    "@contextos-ai/tsconfig": "workspace:*",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.22.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "pg": "^8.20.0"
  }
}
